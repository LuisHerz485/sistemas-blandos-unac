# --- Editores (se comparten solo los ajustes del proyecto en VS Code) ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Logs ---
*.log
npm-debug.log*

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini
