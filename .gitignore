# --- Dependencias ---
node_modules/

# --- Build y cachés ---
dist/
*.tsbuildinfo
*.local
vite.config.*.timestamp-*
.eslintcache
coverage/

# --- Variables de entorno (solo se versiona la plantilla) ---
.env
.env.*
!.env.example

# --- Netlify CLI (enlace local al sitio) ---
.netlify/

