# Copia este archivo como .env.local y completa los valores de tu Google Form.
# En Netlify: Site configuration → Environment variables (mismos nombres).
# Son valores públicos (terminan en el JavaScript del sitio); no son secretos.
# Si falta alguno, el chatbot funciona en "modo demo" y no envía nada.

# Texto entre /d/e/ y /viewform en el enlace del formulario.
VITE_GOOGLE_FORM_ID=

# IDs de cada pregunta (formato entry.123456789), del "enlace prellenado".
VITE_GOOGLE_ENTRY_NOMBRE=
VITE_GOOGLE_ENTRY_CORREO=
VITE_GOOGLE_ENTRY_TIPO=
VITE_GOOGLE_ENTRY_MENSAJE=
VITE_GOOGLE_ENTRY_AUTORIZACION=
